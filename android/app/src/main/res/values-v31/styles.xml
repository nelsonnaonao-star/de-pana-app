<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Variante API 31+ de AppTheme.NoActionBar, el tema que BridgeActivity aplica
         en tiempo de ejecucion (BridgeActivity.java:26). Sin esta variante, el sistema
         resuelve el SplashScreen contra un tema sin atributos windowSplashScreen*, por
         lo que dibuja el fondo pero no el icono. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#111827</item>
        <item name="windowSplashScreenBackground">#0A1F1C</item>
        <item name="android:windowSplashScreenBackground">#0A1F1C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/wepa_splash_icon</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/wepa_splash_icon</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowSplashScreenBackground">#0A1F1C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wepa_splash_icon</item>
        <item name="android:windowSplashScreenBackground">#0A1F1C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/wepa_splash_icon</item>
    </style>
</resources>
